ADDR=:8080
DB_PATH=data/transit-hub.db
CONTROL_DB_PATH=data/transit-hub.db
USAGE_DB_PATH=data/transit-hub-usage.db
TELEMETRY_DB_PATH=data/transit-hub-telemetry.db
TELEMETRY_RETENTION=720h
CONFIG_DIR=configs
ISSUER_CONFIG_PATH=configs/issuer/config.yaml
ADMIN_TOKEN=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
ADMIN_SESSION_TTL=24h
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SESSION_ACTIVE_WINDOW=5m
LOG_LEVEL=info
UPSTREAM_TIMEOUT=5m
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN=30s
CURRENCY=CNY
RATE_LIMIT_TIMEZONE=Asia/Shanghai
# Optional: used by configs/providers/bailian.yaml when Token Plan is enabled.
BAILIAN_API_KEY=sk-your-token-plan-key
# Optional: used by configs/providers/babelark.yaml.
BABELARK_API_KEY=sk-your-babelark-key

# Optional: external access-token /api/bind-apikey configuration.
# ACCESS_KEY_CONFIG_PATH=configs/access-key/config.yaml
# Generate a random base64-encoded 32-byte key; never commit the real value.
# TRANSIT_BIND_KEY_V1=<base64-encoded-32-random-bytes>

# Soft-budget overshoot guard: simultaneous upstream requests per API key.
MAX_CONCURRENT_PER_KEY=16
